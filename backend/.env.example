# Runtime configuration is loaded from ../.env. Copy ../.env.example there and
# replace every placeholder; this file mirrors the supported settings.
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/sonic_search_replica
JWT_SECRET=generate-a-unique-random-value-of-at-least-32-characters
CORS_ORIGIN=http://127.0.0.1:5178
MEDIA_STORAGE_ROOT=/tmp/sonic-media-local
APP_HOST=127.0.0.1
BACKEND_PORT=3061
MAX_UPLOAD_BYTES=5242880
MAX_DURATION_SECONDS=600
DAILY_UPLOAD_LIMIT=20
TRUST_PROXY=false
