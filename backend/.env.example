# Sonic Search Replica - backend environment configuration
# Copy this file to .env (in the parent project root) and fill in values.

# OpenRouter / LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# JWT
JWT_SECRET=change-me-in-production

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sonic_search_replica
DB_USER=postgres
DB_PASSWORD=

# Server
BACKEND_PORT=3001
